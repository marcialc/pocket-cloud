{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pocket-cloud",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  "assets": {
    // The React app (built by Vite) is served as static assets. Only /api/*
    // reaches the Worker; everything else falls back to index.html.
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PLAYER_SAVE", "class_name": "PlayerSaveDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PlayerSaveDO"] }]
}
